<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Заголовок -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="⭐ Избранное"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#1A1A1A" />

        <TextView
            android:id="@+id/tv_update"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Обновить"
            android:textSize="11sp"
            android:textColor="#2196F3" />

    </LinearLayout>

    <!-- Место 1 -->
    <LinearLayout
        android:id="@+id/fav_item_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingVertical="8dp">

        <TextView
            android:id="@+id/fav_title_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Нет избранных"
            android:textSize="13sp"
            android:textColor="#333333"
            android:maxLines="1"
            android:ellipsize="end" />

        <ImageView
            android:id="@+id/fav_route_1"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_directions" />

    </LinearLayout>

    <!-- Место 2 -->
    <LinearLayout
        android:id="@+id/fav_item_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingVertical="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/fav_title_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text=""
            android:textSize="13sp"
            android:textColor="#333333"
            android:maxLines="1"
            android:ellipsize="end" />

        <ImageView
            android:id="@+id/fav_route_2"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_directions" />

    </LinearLayout>

    <!-- Место 3 -->
    <LinearLayout
        android:id="@+id/fav_item_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingVertical="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/fav_title_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text=""
            android:textSize="13sp"
            android:textColor="#333333"
            android:maxLines="1"
            android:ellipsize="end" />

        <ImageView
            android:id="@+id/fav_route_3"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_directions" />

    </LinearLayout>

    <!-- Разделитель -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E0E0"
        android:layout_marginVertical="8dp" />

    <!-- Кнопка открыть приложение -->
    <TextView
        android:id="@+id/tv_open_app"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Открыть приложение →"
        android:textSize="12sp"
        android:textColor="#666666"
        android:gravity="center"
        android:paddingVertical="8dp" />

</LinearLayout>