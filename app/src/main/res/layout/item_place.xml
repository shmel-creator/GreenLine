<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/GreenLine.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">

        <!-- Левая часть: фото + текст - центрируем вертикально -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginEnd="12dp">

            <ImageView
                android:id="@+id/iv_image"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:scaleType="centerCrop"
                android:background="@color/gray_lighter" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:id="@+id/tv_title"
                    style="@style/GreenLine.Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tv_address"
                    style="@style/GreenLine.Subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" />

                <RatingBar
                    android:id="@+id/rating_bar"
                    style="@style/GreenLine.RatingBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:numStars="5"
                    android:stepSize="1"
                    android:rating="0"
                    android:isIndicator="false"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/tv_distance"
                    style="@style/GreenLine.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Расчёт..."
                    android:textSize="12sp"
                    android:textColor="@color/blue"
                    android:layout_marginTop="4dp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Кнопки - остаются сверху (без центрирования) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="top">

            <ImageButton
                android:id="@+id/btn_favorite"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_favorite_border"
                app:tint="@color/gray" />

            <Button
                android:id="@+id/btn_route"
                style="@style/GreenLine.Button.Small"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="Маршрут"
                android:backgroundTint="@color/blue"
                android:layout_marginTop="8dp" />

            <ImageButton
                android:id="@+id/btn_audio"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_headphones"
                app:tint="@color/purple" />

            <ImageButton
                android:id="@+id/btn_reviews"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_reviews"
                app:tint="@color/orange" />

            <ImageButton
                android:id="@+id/btn_share"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_share"
                app:tint="@color/purple" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>