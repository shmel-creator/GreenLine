<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Заголовки -->
    <style name="GreenLine.Title" parent="TextAppearance.AppCompat.Title">
        <item name="android:textColor">@color/black</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/app_sans</item>
    </style>

    <style name="GreenLine.Subtitle" parent="TextAppearance.AppCompat.Subhead">
        <item name="android:textColor">@color/gray</item>
        <item name="android:fontFamily">@font/app_sans</item>
    </style>

    <!-- Текст -->
    <style name="GreenLine.Body" parent="TextAppearance.AppCompat.Body1">
        <item name="android:textColor">@color/black</item>
        <item name="android:fontFamily">@font/app_sans</item>
    </style>

    <!-- Карточки -->
    <style name="GreenLine.Card" parent="CardView">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">4dp</item>
        <item name="cardBackgroundColor">@color/white</item>
    </style>

    <!-- Кнопки -->
    <style name="GreenLine.Button" parent="Widget.AppCompat.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/app_sans</item>
        <item name="android:paddingVertical">12dp</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="GreenLine.Button.Small">
        <item name="android:paddingVertical">8dp</item>
        <item name="android:textSize">11sp</item>
        <item name="android:minHeight">32dp</item>
    </style>

    <!-- Круглые кнопки -->
    <style name="RoundButton" parent="Widget.AppCompat.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/app_sans</item>
        <item name="android:background">@drawable/round_button_bg</item>
    </style>

    <style name="RoundButtonSmall" parent="RoundButton">
        <item name="android:textSize">11sp</item>
        <item name="android:padding">8dp</item>
    </style>

    <!-- RatingBar -->
    <style name="GreenLine.RatingBar" parent="Widget.AppCompat.RatingBar">
        <item name="android:progressDrawable">@drawable/custom_rating_bar</item>
        <item name="android:minHeight">16dp</item>
        <item name="android:maxHeight">16dp</item>
    </style>

</resources>